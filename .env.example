# 복사해서 .env로 쓴다. 실제 값이 든 .env는 저장소에 올리지 않는다.
POSTGRES_USER=daboyeo
POSTGRES_PASSWORD=daboyeo
POSTGRES_DB=daboyeo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://daboyeo:daboyeo@localhost:5432/daboyeo
SERVER_PORT=8000
SNAPSHOT_DIR=server_data/snapshots
# B3에서 쓴다 (docs/DESIGN.md 6장 초안값)
DEDUP_DISTANCE_M_POTHOLE_CRACK=30
DEDUP_DISTANCE_M_LANE_WEAR=40
# 노출 기준 θ: 유형별 값은 모델 카드(class_conf_draft)에서, 카드에 없는 유형은 CONFIDENCE_VISIBLE
CONFIDENCE_VISIBLE_JSON=ai/models/detector_v3.json
CONFIDENCE_VISIBLE=0.6
MIN_VEHICLES_VISIBLE=2
# 관리자 지도(네이버 지도). 네이버 클라우드 플랫폼 Maps(Dynamic Map) Client ID. 비우면 도로선 지도로 그린다
NAVER_MAP_KEY_ID=
# 결함 주소(네이버 클라우드 Reverse Geocoding). 위 Client ID 의 Client Secret. 콘솔 Application 에서 Reverse Geocoding 을 켠다.
# 비우면 주소 없이 좌표·지도만 보인다. 결함이 처음 생길 때 한 번 받아 DB 에 저장한다(시연 때 인터넷이 없어도 보인다)
NAVER_MAP_CLIENT_SECRET=
# 모의 문자의 링크 주소와 유효 시간 (실제 문자는 보내지 않는다)
PUBLIC_BASE_URL=http://localhost:8501
LINK_TTL_HOURS=72
